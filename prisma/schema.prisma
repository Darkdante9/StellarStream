generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

// Mirroring the Stream state from Soroban
model Stream {
  id              String       @id // The Contract ID or unique Stream ID
  sender          String
  receiver        String
  tokenAddress    String
  amountPerSecond BigInt
  totalAmount     BigInt
  status          StreamStatus @default(ACTIVE)
  endTime         DateTime?

  @@index([sender])
  @@index([receiver])
  @@index([endTime])
}

// Tracks the last synced blockchain state
model SyncState {
  id                 Int @id @default(1)
  lastLedgerSequence Int @default(0)
}

enum StreamStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

// ── V3 Fund-Split Tables ──────────────────────────────────────────────────────

// Header record for a single fund-split disbursement
model Disbursement {
  id             String             @id @default(cuid())
  senderAddress  String             @map("sender_address")
  totalAmount    String             @map("total_amount")
  asset          String
  txHash         String             @unique @map("tx_hash")
  createdAt      DateTime           @default(now()) @map("created_at")

  recipients     SplitRecipient[]

  @@index([senderAddress])
  @@index([txHash])
}

// Individual payout row linked to a parent Disbursement
model SplitRecipient {
  id               String       @id @default(cuid())
  disbursementId   String       @map("disbursement_id")
  recipientAddress String       @map("recipient_address")
  amount           String
  status           PayoutStatus @default(PENDING)

  disbursement     Disbursement @relation(fields: [disbursementId], references: [id])

  @@index([disbursementId])
  @@index([recipientAddress])
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
}

// ── Escrow Tables ─────────────────────────────────────────────────────────────

enum EscrowState {
  PENDING_FUNDING
  ACTIVE
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum ReleaseConditionType {
  TIME_LOCK
  MULTI_SIG
  MILESTONE
}

enum PartyRole {
  DEPOSITOR
  RECIPIENT
  ARBITER
}

// Main escrow agreement
model Escrow {
  id                   String             @id @default(cuid())
  title                String
  description          String?
  tokenAddress         String             @map("token_address")
  amount               BigInt
  state                EscrowState        @default(PENDING_FUNDING)
  releaseConditionType ReleaseConditionType
  releaseConditionData String             @map("release_condition_data") // JSON blob
  expiresAt            DateTime?          @map("expires_at")
  contractId           String?            @unique @map("contract_id") // Soroban contract ID
  txHash               String?            @unique @map("tx_hash")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  parties              EscrowParty[]
  disputes             EscrowDispute[]

  @@index([state])
  @@index([createdAt])
}

// Parties involved in the escrow
model EscrowParty {
  id             String   @id @default(cuid())
  escrowId       String   @map("escrow_id")
  address        String
  role           PartyRole
  weight         Int      @default(1) // For multi-sig threshold
  signed         Boolean  @default(false) // Whether they signed the agreement
  signedAt       DateTime? @map("signed_at")

  escrow         Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([address])
}

// Dispute records
model EscrowDispute {
  id             String   @id @default(cuid())
  escrowId       String   @map("escrow_id")
  raisedBy       String   @map("raised_by")
  reason         String
  resolution     String?  // Resolution description
  resolvedBy     String?  @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  escrow         Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}